# Nana H3 Animation Auto · Public standalone configuration
# Copy to .env. Never commit real keys.

# ---------- Director: choose exactly one ----------
# agent = local coding/desktop Agent owns planning (default, no model key)
# api   = direct model-provider compatibility mode
NANA_DIRECTOR_MODE=agent
NANA_H3_AGENT_ONLY=true

# Direct API mode (used when NANA_DIRECTOR_MODE=api)
# The public adapter contract is OpenAI-compatible. Existing GLM compatibility remains available.
# NANA_DIRECTOR_API_PROVIDER=openai_compatible
# NANA_DIRECTOR_API_BASE_URL=
# NANA_DIRECTOR_API_MODEL=
# NANA_DIRECTOR_API_KEY=
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_MODEL=glm-5.3

# ---------- Image generation adapter ----------
# none | cli | api
NANA_IMAGE_MODE=none
# CLI receives request JSON in environment variable NANA_ADAPTER_PAYLOAD.
# NANA_IMAGE_CLI_COMMAND=
# NANA_IMAGE_CLI_ARGS=
# HTTP adapter POSTs JSON to this endpoint with optional Bearer token.
# NANA_IMAGE_API_BASE_URL=
# NANA_IMAGE_API_MODEL=
# NANA_IMAGE_API_KEY=

# ---------- Video generation adapter ----------
# h3 | cli | api
NANA_VIDEO_MODE=h3
# NANA_VIDEO_CLI_COMMAND=
# NANA_VIDEO_CLI_ARGS=
# NANA_VIDEO_API_BASE_URL=
# NANA_VIDEO_API_MODEL=
# NANA_VIDEO_API_KEY=

# Public engine capability switch: 15 | 30
# H3 itself is capped at 15s. 30s becomes active only when VIDEO_MODE=cli/api.
NANA_VIDEO_DURATION_MAX=15

# ---------- MiniMax H3 / ComfyUI ----------
NANA_H3_COMFY_URL=http://127.0.0.1:8188
NANA_H3_PORT=8797

# Runtime data defaults to ./data next to server.mjs
# NANA_H3_DATA_DIR=./data

# Optional media import folder
# NANA_LOVART_OUTPUT_DIR=./data/media-downloads

# Optional GPU switch bridge
# NANA_GPU_SWITCH_URL=http://127.0.0.1:8021
