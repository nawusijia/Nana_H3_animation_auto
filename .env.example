# ---------- Default: Agent-owned director planning ----------
# Keep this true for the public open-source workflow.
# Your local coding/desktop Agent performs screenplay analysis, Scene/Shot/Sequence planning,
# Prompt writing and review through /api/agent/bootstrap. No model API key is required.
NANA_H3_AGENT_ONLY=true

# ---------- Required: your MiniMax H3 ComfyUI endpoint ----------
# Local ComfyUI example:
NANA_H3_COMFY_URL=http://127.0.0.1:8188

# ---------- Optional ----------
NANA_H3_PORT=8797

# Where H3 projects, task state and outputs are stored.
# Default: ./data next to server.mjs
# NANA_H3_DATA_DIR=./data

# Optional media import folder used by the Lovart asset-import endpoint.
# Default: <NANA_H3_DATA_DIR>/media-downloads
# NANA_LOVART_OUTPUT_DIR=./data/media-downloads

# Optional GPU switch bridge. Leave unset for a normal single-purpose local ComfyUI machine.
# If you have a custom GPU ownership/switch service, it must provide POST /switch/h3 and GET /health.
# NANA_GPU_SWITCH_URL=http://127.0.0.1:8021

# ---------- Legacy compatibility only ----------
# The old browser-driven GLM planning flow is retained behind an explicit opt-in for existing users.
# New users should NOT configure this section.
# NANA_H3_AGENT_ONLY=false
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_MODEL=glm-5.3
