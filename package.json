{
  "name": "nana-h3-animation-auto",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone MiniMax H3 automatic animation director workbench.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "server:check": "node --check server.mjs",
    "check": "npm run typecheck && npm run build && npm run server:check",
    "start": "npm run build && node server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
